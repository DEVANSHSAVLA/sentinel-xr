/* SENTINEL-XR 2.0 — OBSIDIAN NEURAL UI TOOLKIT STYLESHEET */

:root {
    --bg-base: #070B16;
    --bg-surface: #0C1222;
    --bg-elevated: #111A2D;
    --accent-blue: #477BFF;
    --accent-cyan: #00D9FF;
    --accent-violet: #895CFF;
    --text-primary: #ECF3FF;
    --text-secondary: #91A2BC;
    --status-critical: #FF456A;
    --status-warning: #FFB547;
    --status-success: #22D3A6;
}

.root-container {
    width: 100%;
    height: 100%;
    background-color: var(--bg-base);
    color: var(--text-primary);
    flex-direction: column;
}

.top-bar {
    height: 52px;
    background-color: rgba(12, 18, 34, 0.9);
    border-bottom-width: 1px;
    border-bottom-color: rgba(71, 123, 255, 0.2);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
}

.brand-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text-primary);
    letter-spacing: 2px;
}

.brand-highlight {
    color: var(--accent-cyan);
}

.nav-row {
    flex-direction: row;
    align-items: center;
}

.nav-button {
    background-color: transparent;
    border-width: 0;
    color: var(--text-secondary);
    font-size: 12px;
    padding: 6px 14px;
    transition-duration: 0.15s;
}

.nav-button:hover {
    color: var(--text-primary);
}

.nav-button-active {
    color: var(--accent-cyan);
    border-bottom-width: 2px;
    border-bottom-color: var(--accent-cyan);
    -unity-font-style: bold;
}

.glass-card {
    background-color: rgba(17, 26, 45, 0.8);
    border-width: 1px;
    border-color: rgba(71, 123, 255, 0.18);
    border-radius: 10px;
    padding: 16px;
    margin: 6px;
}

.kpi-title {
    font-size: 11px;
    color: var(--text-secondary);
    letter-spacing: 1px;
}

.kpi-value {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-primary);
    margin-top: 4px;
}

.primary-button {
    background-color: var(--accent-blue);
    color: #FFFFFF;
    font-size: 12px;
    -unity-font-style: bold;
    border-radius: 8px;
    padding: 8px 18px;
    border-width: 0;
    transition-duration: 0.15s;
}

.primary-button:hover {
    background-color: #3567EE;
}

.danger-button {
    background-color: var(--status-critical);
    color: #FFFFFF;
    font-size: 12px;
    -unity-font-style: bold;
    border-radius: 8px;
    padding: 8px 18px;
    border-width: 0;
}
